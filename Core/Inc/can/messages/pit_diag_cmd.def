/*
 * 0x7E0  PitDiag_cmd -- RX. Magic 0xDEADBEEF enables the pit-diag stream
 * (0x700..0x705), 0x00000000 disables it. Replied to with PitDiag_ack (0x7E1).
 * Session flag only (not persisted).
 */

CAN_MSG(PitDiag_cmd, 0x7E0, 4, "Pit_Tool", 0)
    FIELD_BE (magic, uint32_t, 0, 32, 1, 0, "magic")
CAN_MSG_END(PitDiag_cmd)
