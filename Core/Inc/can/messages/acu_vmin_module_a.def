/*
 * 0x131  ACU_vmin_module_a -- RX from the AMS. Per-module minimum cell
 * voltage, modules 0..2 (mV, big-endian). Feeds the dash per-module display
 * (0x51C on CAN3). AMS-owned layout (see IFS08-CE-AMS
 * acu_vmin_module_a.def); the ECU consumes it.
 */

CAN_MSG(ACU_vmin_module_a, 0x131, 6, "AMS", 100)
    FIELD_BE (vmin_module0, uint16_t, 0, 16, 1, 0, "mV")
    FIELD_BE (vmin_module1, uint16_t, 2, 16, 1, 0, "mV")
    FIELD_BE (vmin_module2, uint16_t, 4, 16, 1, 0, "mV")
CAN_MSG_END(ACU_vmin_module_a)
