/*
 * 0x132  ACU_vmin_module_b -- RX from the AMS. Per-module minimum cell
 * voltage, modules 3..4 (mV, big-endian). Feeds the dash per-module display
 * (0x51D on CAN3). AMS-owned layout (see IFS08-CE-AMS
 * acu_vmin_module_b.def); the ECU consumes it.
 */

CAN_MSG(ACU_vmin_module_b, 0x132, 4, "AMS", 100)
    FIELD_BE (vmin_module3, uint16_t, 0, 16, 1, 0, "mV")
    FIELD_BE (vmin_module4, uint16_t, 2, 16, 1, 0, "mV")
CAN_MSG_END(ACU_vmin_module_b)
