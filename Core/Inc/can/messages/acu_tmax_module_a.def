/*
 * 0x136  ACU_tmax_module_a -- RX from the AMS. Per-module max temperature,
 * modules 0..2 (degC, big-endian signed). Feeds the dash per-module display
 * (0x520 on CAN3). AMS-owned layout (see IFS08-CE-AMS
 * acu_tmax_module_a.def); the ECU consumes it.
 */

CAN_MSG(ACU_tmax_module_a, 0x136, 6, "AMS", 250)
    FIELD_BE_S (tmax_module0, int16_t, 0, 16, 1, 0, "degC")
    FIELD_BE_S (tmax_module1, int16_t, 2, 16, 1, 0, "degC")
    FIELD_BE_S (tmax_module2, int16_t, 4, 16, 1, 0, "degC")
CAN_MSG_END(ACU_tmax_module_a)
