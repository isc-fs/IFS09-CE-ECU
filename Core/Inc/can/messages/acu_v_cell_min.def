/*
 * 0x12C  ACU_v_cell_min -- RX from the AMS. Pack-wide minimum cell voltage
 * (mV, big-endian). Feeds the low-cell-voltage torque derate in the control
 * core. AMS-owned layout; the ECU consumes it.
 */

CAN_MSG(ACU_v_cell_min, 0x12C, 2, "AMS", 100)
    FIELD_BE (min_cell_mV, uint16_t, 0, 16, 1, 0, "mV")
CAN_MSG_END(ACU_v_cell_min)
